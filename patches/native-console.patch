+
+static void update_controller_ports(Frontend &f)
+{
+    if (!f.m) return;
+    f.m->controllers = 1; /* Keyboard remains available on port 1. */
+    for (int port = 1; port < f.max_players; port++) if (pad_at(f, port)) f.m->controllers |= (uint8_t)(1u << port);
+}
+
+static void add_controller(Frontend &f, int index)
+{
+    if (index < 0 || !SDL_IsGameController(index)) return;
+    SDL_JoystickID id = SDL_JoystickGetDeviceInstanceID(index);
+    for (int port = 0; port < 4; port++) {
+        SDL_GameController *pad = pad_at(f, port);
+        if (pad && SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(pad)) == id) return;
+    }
+    for (int port = 0; port < f.max_players; port++) {
+        if (pad_at(f, port)) continue;
+        SDL_GameController *pad = SDL_GameControllerOpen(index);
+        if (!pad) return;
+        if (port == 0) set_pad(f, pad);
+        else f.extra_pads[port - 1] = pad;
+        update_controller_ports(f);
+        return;
+    }
+}
+
+static void remove_controller(Frontend &f, SDL_JoystickID id)
+{
+    for (int port = 0; port < 4; port++) {
+        SDL_GameController *pad = pad_at(f, port);
+        if (!pad || SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(pad)) != id) continue;
+        if (port == 0) set_pad(f, nullptr);
+        else { SDL_GameControllerClose(pad); f.extra_pads[port - 1] = nullptr; }
+        if (f.m) n64_set_buttons(f.m, port, 0, 0, 0);
+        update_controller_ports(f);
+        return;
+    }
+}
