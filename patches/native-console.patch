+struct PhantomCode { uint32_t address; uint16_t value; bool wide; };
+
+static std::vector<PhantomCode> phantom_load_codes(const char *path)
+{
+    std::vector<PhantomCode> codes;
+    FILE *file = path ? fopen(path, "rb") : nullptr;
+    if (!file) return codes;
+    char line[512];
+    while (codes.size() < 512 && fgets(line, sizeof line, file)) {
+        if (line[0] != '1' || line[1] != '\t') continue;
+        const char *code = strrchr(line, '\t');
+        unsigned command, value; char extra;
+        if (!code || sscanf(code + 1, "%8x %4x %c", &command, &value, &extra) != 2) continue;
+        unsigned type = command >> 24, address = command & 0x00ffffffu;
+        if (address >= 0x800000u || (type != 0x80 && type != 0x81) ||
+            (type == 0x80 && value > 255) || (type == 0x81 && (address & 1))) continue;
+        codes.push_back({address, (uint16_t)value, type == 0x81});
+    }
+    fclose(file);
+    return codes;
+}
+
+static void phantom_apply_codes(N64Machine *m, const std::vector<PhantomCode> &codes)
+{
+    for (const PhantomCode &code : codes) {
+        uint32_t size = code.wide ? 2u : 1u;
+        if (code.address >= m->rdram_size || size > m->rdram_size - code.address) continue;
+        if (code.wide) n64_bus_write16(&m->cpu, code.address, code.value);
+        else n64_bus_write8(&m->cpu, code.address, (uint8_t)code.value);
+    }
+}
