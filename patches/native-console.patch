+/* A captured RDRAM block may span 4 KiB pages which a game's TLB maps to
+ * unrelated physical pages. Checking only its first translated address and
+ * contiguous physical bytes can select code with the wrong instruction at
+ * the page boundary (including a branch delay slot). Verify the current
+ * virtual-to-physical mapping for each page before entering compiled code. */
+static bool block_mapping_matches(const N64Machine *m, uint32_t key, uint32_t paddr, const N64RcBlock *blk)
+{
+    const uint32_t delta = paddr - blk->paddr;
+    if (key < delta) return false;
+    const uint32_t base = key - delta;
+    const uint64_t end = (uint64_t)base + blk->size;
+    if (!blk->size || end > 0x100000000ull) return false;
+    uint64_t va = base;
+    while (va < end) {
+        uint32_t actual;
+        const uint64_t signed_va = (uint64_t)(int64_t)(int32_t)(uint32_t)va;
+        if (!n64_cpu_translate_quiet(&m->cpu, signed_va, &actual) ||
+            (uint64_t)actual != (uint64_t)blk->paddr + (va - base)) return false;
+        va = (va | 0xfffull) + 1u;
+    }
+    return true;
+}
