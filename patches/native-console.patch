+        if (!pad_at(f, i) || !joy[i]) { ok = false; break; }
+    }
+    if (ok) {
+        remove_controller(f, SDL_JoystickInstanceID(joy[2]));
+        remove_controller(f, SDL_JoystickInstanceID(joy[3]));
+        f.max_players = 2;
+        add_controller(f, devices[2]); add_controller(f, devices[3]);
+        ok = f.m->controllers == 3 && !pad_at(f, 2) && !pad_at(f, 3);
+        f.max_players = 4;
+        add_controller(f, devices[2]); add_controller(f, devices[3]);
+        ok = ok && f.m->controllers == 15 && pad_at(f, 2) && pad_at(f, 3);
+        SDL_JoystickSetVirtualButton(joy[0], SDL_CONTROLLER_BUTTON_A, 1);
+        SDL_JoystickSetVirtualButton(joy[1], SDL_CONTROLLER_BUTTON_X, 1);
+        SDL_JoystickSetVirtualButton(joy[2], SDL_CONTROLLER_BUTTON_START, 1);
+        SDL_JoystickSetVirtualAxis(joy[3], SDL_CONTROLLER_AXIS_LEFTX, 32767);
+        SDL_JoystickUpdate();
+        PadState p0 = gameplay_input(f, 0), p1 = gameplay_input(f, 1);
+        PadState p2 = gameplay_input(f, 2), p3 = gameplay_input(f, 3);
+        ok = ok && f.m->controllers == 15 && p0.buttons == n64_action_button(N64_ACTION_A) &&
+             p1.buttons == n64_action_button(N64_ACTION_B) && p2.buttons == n64_action_button(N64_ACTION_START) &&
+             p3.buttons == 0 && p3.x == N64_STICK_MAX;
+        SDL_JoystickID id = SDL_JoystickInstanceID(joy[1]);
+        n64_set_buttons(f.m, 1, p1.buttons, p1.x, p1.y);
+        remove_controller(f, id);
+        ok = ok && f.m->controllers == 13 && !pad_at(f, 1) && f.m->buttons[1] == 0 && pad_at(f, 2) && pad_at(f, 3);
+        add_controller(f, devices[1]);
+        ok = ok && f.m->controllers == 15 && pad_at(f, 1) && pad_at(f, 2) && pad_at(f, 3);
+    }
+    for (int i = 0; i < 4; i++) {
+        SDL_GameController *pad = pad_at(f, i);
+        if (pad) SDL_GameControllerClose(pad);
+        if (joy[i]) SDL_JoystickClose(joy[i]);
+    }
+    for (int i = 3; i >= 0; i--) if (devices[i] >= 0) SDL_JoystickDetachVirtual(devices[i]);
+    n64_destroy(f.m);
+    return ok;
+}
