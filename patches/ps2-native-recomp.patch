diff --git a/scripts/learn_cache.py b/scripts/learn_cache.py
new file mode 100644
index 0000000..2b840bd
--- /dev/null
+++ b/scripts/learn_cache.py
@@ -0,0 +1,111 @@
+"""What exploring and playing found for one disc, kept between projects.
+
+usage: learn_cache.py key <boot program>
+       learn_cache.py restore <cache folder> <game folder>
+       learn_cache.py save <cache folder> <game folder>
+
+port.sh gives every project its own games/<name> folder, so a second port of the same disc used to start exploring from
+nothing, and the code met while playing a build never came back. The cache folder is keyed by the boot program's SHA-1
+(`key`), which the launcher of a compiled game can work out too: a play session writes its misses and the vector programs
+it recorded under parties/<session>/ there, and the next port picks them up with what earlier ports explored.
+
+restore adds the cache's entry points (and every session's misses) to entries.txt and copies the recorded vector programs
+and captured code window images the game folder does not have yet. save puts the game folder's back. Both only ever add:
+nothing in the cache or the game folder is removed or replaced, so a session read twice costs nothing.
+"""
+import hashlib
+import os
+import shutil
+import sys
+import tempfile
+from pathlib import Path
+
+
+def token(t):
+    name, _, at = t.rpartition(':')
+    return (name + ':' if name else '') + '%x' % int(at, 16)
+
+
+def read_tokens(path):
+    try:
+        text = Path(path).read_text(encoding='ascii', errors='replace')
+    except OSError:
+        return set()
+    out = set()
+    for t in text.split():
+        try:
+            out.add(token(t))
+        except ValueError:
+            pass  # a line a crashed session left half written
+    return out
+
+
+def write_tokens(path, tokens):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.NamedTemporaryFile('w', encoding='ascii', newline='\n', dir=path.parent, delete=False) as out:
+        out.write(''.join(t + '\n' for t in sorted(tokens)))
+        temporary = Path(out.name)
+    os.replace(temporary, path)
+
+
+def copy_new(source, destination):
+    """Copies the files of source that destination lacks; returns how many."""
+    source, destination = Path(source), Path(destination)
+    if not source.is_dir():
+        return 0
+    copied = 0
+    for item in source.iterdir():
+        if item.is_file() and not (destination / item.name).exists():
+            destination.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(item, destination / item.name)
+            copied += 1
+    return copied
+
+
+def sessions(cache):
+    folder = Path(cache) / 'parties'
+    return sorted(p for p in folder.iterdir() if p.is_dir()) if folder.is_dir() else []
+
+
+def restore(cache, game):
+    cache, game = Path(cache), Path(game)
+    entries = game / 'entries.txt'
+    known = read_tokens(entries)
+    explored = read_tokens(cache / 'entries.txt')
+    played = set()
+    for session in sessions(cache):
+        played |= read_tokens(session / 'misses.txt')
+    new = (explored | played) - known
+    if new:
+        with open(entries, 'a', encoding='ascii', newline='\n') as out:
+            for t in sorted(new):
+                out.write(t + '\n')
+    programs = copy_new(cache / 'vu1', game / 'vu1') + sum(copy_new(s / 'vu1', game / 'vu1') for s in sessions(cache))
+    windows = copy_new(cache / 'overlays', game / 'overlays') if (game / 'overlays').is_dir() else 0
+    print('learned before for this disc: %d entry points (%d met while playing), %d vector programs, %d code window images'
+          % (len(new), len(played - explored - known), programs, windows))
+
+
+def save(cache, game):
+    cache, game = Path(cache), Path(game)
+    entries = read_tokens(cache / 'entries.txt') | read_tokens(game / 'entries.txt')
+    write_tokens(cache / 'entries.txt', entries)
+    programs = copy_new(game / 'vu1', cache / 'vu1')
+    windows = copy_new(game / 'overlays', cache / 'overlays')
+    print('kept for the next port of this disc: %d entry points, %d new vector programs, %d new code window images'
+          % (len(entries), programs, windows))
+
+
+def main(argv):
